<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roguesweeper">

        <!-- Pantalla Principal / Menú i Selecció de Ranura -->
        <activity
            android:name=".presentation.screens.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Joc (GameScreen) -->
        <activity
            android:name=".presentation.screens.GameActivity"
            android:exported="false"
            android:parentActivityName=".presentation.screens.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Botiga de Millores (ShopScreen) -->
        <activity
            android:name=".presentation.screens.ShopActivity"
            android:exported="false"
            android:parentActivityName=".presentation.screens.MainActivity"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
