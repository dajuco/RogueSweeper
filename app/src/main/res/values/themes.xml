<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Roguesweeper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/bg_dark_gradient_top</item>
        <item name="android:navigationBarColor">@color/bg_dark_gradient_bottom</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Custom Dark Dialog Theme -->
        <item name="alertDialogTheme">@style/Theme.Roguesweeper.Dialog</item>
    </style>

    <style name="Theme.Roguesweeper" parent="Base.Theme.Roguesweeper" />

    <style name="Theme.Roguesweeper.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/bg_card</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Roguesweeper.Dialog</item>
    </style>

    <style name="ShapeAppearance.Roguesweeper.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">18dp</item>
    </style>
</resources>
