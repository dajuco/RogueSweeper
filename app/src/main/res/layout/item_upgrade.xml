<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUpgradeIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_hud_stat"
                android:gravity="center"
                android:textSize="22sp"
                tools:text="🛡️" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUpgradeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Capacitat d'Escuts" />

                <TextView
                    android:id="@+id/tvUpgradeLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/shield_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Nivell 1 / 3" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvUpgradeDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Permet sobreviure a detonacions accidentals per partida." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/card_stroke_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUpgradeCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="🪙 100 punts" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyUpgrade"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="@color/primary_accent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/btn_upgrade"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
