<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#5A7196">
    <item>
        <layer-list>
            <!-- Bottom bevel/shadow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/cell_covered_bevel_dark" />
                </shape>
            </item>
            <!-- Main tile body with top highlight border -->
            <item
                android:bottom="2dp"
                android:right="1dp"
                android:left="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/cell_covered_bg_top"
                        android:endColor="@color/cell_covered_bg_bottom"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/cell_covered_bevel_light" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
