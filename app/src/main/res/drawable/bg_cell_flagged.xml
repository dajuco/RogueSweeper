<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/cell_covered_bevel_dark" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:right="1dp"
        android:left="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#33240D"
                android:endColor="#1E1508"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_gold" />
        </shape>
    </item>
</layer-list>
